OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI API Keys
#GOOGLE_API_KEY=your_old_google_api_key_here
# Alternative
GOOGLE_API_KEY=your_google_generative_ai_api_key_here

# Beeblio API Keys
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
OPENALEX_API_KEY=your_openalex_api_key_here
OPENALEX_EMAIL=your_email@example.com
CROSSREF_MAILTO=your_email@example.com
UNPAYWALL_EMAIL=your_email@example.com
NCBI_API_KEY=your_ncbi_api_key_here

# Supabase Frontend
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Supabase Backend
DATABASE_URL=postgresql://user:password@host:port/database

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_BUCKET=your_google_cloud_bucket_name
GOOGLE_CLOUD_REGION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=./app-key.json

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_vercel_blob_token_here

NVIDIA_API_KEY=your_nvidia_api_key_here

# Admin

ADMIN_PASSWORD=your_admin_password_here

NEXT_PUBLIC_DISABLE_FREEFORM_STREAM=true

# AI Models Configuration
# -------------------------
# With OpenRouter, you can specify the provider using the format "provider/model-name".
# If no provider is specified (e.g. "gemini-2.5-flash"), it will safely default to "google/".

# Beeblio
BEEBLIO_EVALUATE_MODEL=gemini-2.5-flash
BEEBLIO_SEARCH_MODEL=gemini-2.5-flash

# Chat
# Example of switching provider: CHAT_MODEL=anthropic/claude-3.5-sonnet
CHAT_MODEL=gemini-2.5-flash

# DNAnalyzer
DNANALYZER_MODEL=gemini-2.5-flash

# FlowNote
FLOWNOTE_GENERATE_MODEL=gemini-2.5-flash
FLOWNOTE_UPLOAD_MODEL=gemini-2.5-flash

# Inztagram
# Example of switching provider: INZTAGRAM_GENERATE_MODEL=openai/gpt-4o
INZTAGRAM_EDIT_MODEL=gemini-2.5-flash
INZTAGRAM_GENERATE_MODEL=gemini-2.5-flash
INZTAGRAM_STREAM_MODEL=gemini-2.5-flash
INZTAGRAM_MODEL=gemini-2.5-flash

# Outliner
OUTLINER_CHAT_MODEL=gemini-2.5-flash
OUTLINER_CITE_MODEL=gemini-2.5-flash-lite
OUTLINER_EXPAND_PASSAGE_MODEL=gemini-2.5-flash-lite
OUTLINER_EXPAND_STREAM_MODEL=gemini-2.5-flash
OUTLINER_PARAPHRASE_MODEL=gemini-2.5-flash-lite
OUTLINER_MODEL=gemini-2.5-flash
OUTLINER_STREAM_MODEL=gemini-2.5-flash

# Papermap
PAPERMAP_MODEL=gemini-2.5-flash
PAPERMAP_STREAM_REALTIME_MODEL=gemini-2.5-flash
PAPERMAP_STREAM_MODEL=gemini-2.5-flash
