# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

/videos
*.mp4

app-key*

/test

/docs/test-charts

# pnpm local workspace/build-approval artifact. This is a single-package
# project (no workspaces), and the file has no `packages` field, which makes
# pnpm 9 fail install with "packages field missing or empty".
/pnpm-workspace.yaml
